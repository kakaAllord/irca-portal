# Copy to .env.local.
# Where the portal's server reaches the API. Never exposed to the browser.
API_INTERNAL_URL=http://localhost:4000
# Leave unset: __Host-irca_session in production, irca_session in development,
# the same as the API. Set it only if the API sets its own.
# SESSION_COOKIE_NAME=
# Only on a host other than the API's, such as Vercel: the API's FORWARDING_KEY,
# sent with each visitor's address so sign-in limits count the visitor (D48).
FORWARDING_KEY=
